# Bu dosyayı .env adıyla kopyalayın. Gerçek anahtarı Git'e göndermeyin.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://reveque52.github.io
AI_RATE_LIMIT=20
JIRA_BASE_URL=https://fit-global.atlassian.net
JIRA_EMAIL=your_atlassian_email@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here
